# ==============================================================================
# RootCause / AskData Configuration Environment Variables
# ==============================================================================
# Copy this file to `backend/.env` and insert your API credentials:
# cp .env.example backend/.env
# ==============================================================================

# Active LLM Provider: "openrouter" (default) or "nvidia_nim"
LLM_PROVIDER=openrouter

# ------------------------------------------------------------------------------
# Provider 1: OpenRouter (Primary - Free & Fast Models)
# Obtain key at: https://openrouter.ai/keys
# Recommended free models:
#   - nex-agi/nex-n2.5-mini:free (Fast & robust JSON)
#   - meta-llama/llama-3.2-3b-instruct:free
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free

# ------------------------------------------------------------------------------
# Provider 2: NVIDIA NIM (Secondary / Automatic Fallback)
# Obtain key at: https://build.nvidia.com/
# Recommended models:
#   - meta/llama-3.2-11b-vision-instruct
#   - meta/llama-3.1-8b-instruct
# ------------------------------------------------------------------------------
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_NIM_MODEL=meta/llama-3.2-11b-vision-instruct

# ------------------------------------------------------------------------------
# Execution & Watchdog Settings
# ------------------------------------------------------------------------------
DATA_DIR=data
SEND_SAMPLES=true
MAX_RESULT_ROWS=1000
NARRATOR_MAX_ROWS=50
QUERY_TIMEOUT_S=20

# ------------------------------------------------------------------------------
# Root-Cause Why Engine & Anomaly Alert Thresholds
# ------------------------------------------------------------------------------
WHY_MAX_CARDINALITY=50
WHY_MIN_SHARE=0.30
WHY_MIN_LIFT=1.5
ALERT_DROP_PCT=10
ALERT_Z=3
ALERT_CONCENTRATION=0.5
